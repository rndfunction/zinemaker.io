      ],
      "textBoxes": [
        { "id": "t-munlbowk-tmqs", "html": "<b>ZINES</b>", "x": 0.48, "y": 1.19, "w": 4.3, "rot": -4, "fontSize": 2.39, "z": 50, "color": "", "hidden": false }
      ],
      "icons": []
    },
    {
      "heading": "What is that?",
      "body": "Zines are little booklets that you make out of one or more pieces of paper. \n\nThe one you have before you is one that makes an eight page booklet out of one piece of paper! You print it, fold it and make on little cut to create a 8 page book that you can distribute! \n\n\n",
      "images": [
        { "id": "i-mupviaxg-vcom", "src": "akar-icons:paper-airplane", "kind": "icon", "x": 1.16, "y": 2.37, "w": 0.6, "rot": 15, "wrap": "free", "z": 0, "hidden": false },
        { "id": "i-mupw27hw-xfgu", "src": "f7:wind", "kind": "icon", "x": 0.91, "y": 2.81, "w": 0.6, "rot": -55, "wrap": "free", "z": 0, "hidden": false }
      ],
      "textBoxes": [],
      "icons": []
    },
    {
      "heading": "Why?",
      "body": "It's a great way to share information or something that's personal to you!  \n\nThere's so much to be learn about, and we don't always have a good way to help spread our story!\n\nMaybe you want to tell a story, or give out information about something that you don't think enough people are knowledgable about! \n\n\n\n\n",
      "images": [
        { "id": "i-muo5gg0g-plu5", "src": "ph:flower", "kind": "icon", "x": 1.5, "y": 2.86, "w": 0.6, "rot": 0, "wrap": "free", "z": 0, "color": "#ff1f1f", "hidden": false },
        { "id": "i-mupvm0qe-qwu0", "src": "ph:flower", "kind": "icon", "x": 1.43, "y": 2.8, "w": 0.74, "rot": 0, "wrap": "free", "z": 1, "color": "#ffc21a", "hidden": false }
      ],
      "textBoxes": [],
      "icons": []
    },
    {
      "heading": "Now let me show you",
      "body": "You can type anything here and let people know about the thing that you're passionate about. You can make your text <b>BOLD, </b><i>italicized, </i>or <u>underlined</u> or change the <font color=\"#ff0000\">c</font><font color=\"#ff9500\">o</font><font color=\"#99ff00\">l</font><font color=\"#0055ff\">o</font><font color=\"#8000ff\">r</font><font color=\"#fb00ff\">!</font>\n\n\n",
      "images": [
        { "id": "i-mupvxoua-9p3h", "src": "", "kind": "sticky", "x": 0.27, "y": 2.42, "w": 1.1, "h": 1.1, "rot": -3, "wrap": "free", "z": 40, "color": "yellow", "hidden": false }
      ],
      "textBoxes": [
        { "id": "t-muo5jv7l-m9v2", "html": "<b>You can also insert text boxes and put text anywhere!&nbsp;</b>", "x": 0.54, "y": 1.58, "w": 1.8, "rot": 11, "fontSize": 1, "z": 10, "color": "", "hidden": false },
        { "id": "t-mupvp7o1-hvwi", "html": "<br>", "x": 0.39, "y": 2.63, "w": 1.04, "rot": -3, "fontSize": 0.58, "z": 30, "hidden": false },
        { "id": "t-mupvsuf3-d0qv", "html": "APPROVED", "x": 0.57, "y": 3.22, "w": 1.6, "rot": -8, "fontSize": 1, "z": 20, "color": "#c8102e", "hidden": false },
        { "id": "t-mupvxyjs-qk97", "html": "Combine the elements to help tell your story!&nbsp;", "x": 0.3, "y": 2.52, "w": 1.14, "rot": -3, "fontSize": 0.64, "z": 50, "hidden": false }
      ],
      "icons": []
    },
