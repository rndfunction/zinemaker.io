      ],
      "textBoxes": [
        { "id": "t-muo5wby8-6wwq", "html": "To your left you'll see that there are layers!&nbsp;<br><br>You can hide or move those to change what's showing up on top!", "x": 0.06, "y": 2.08, "w": 1.8, "rot": 0, "fontSize": 1, "z": 10, "color": "", "hidden": false }
