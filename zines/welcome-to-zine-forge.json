      ],
      "textBoxes": [
        { "id": "t-muo5s5kh-vfuc", "html": "or an icon", "x": 0.02, "y": 2.06, "w": 1.8, "rot": 0, "fontSize": 1, "z": 0, "color": "", "hidden": false },
